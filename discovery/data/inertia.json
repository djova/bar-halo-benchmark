    "filter": "Theta_q(y) = 2 / (1 + |y|^q)",
    "q_values": [
      2,
      4,
      8
    ],
    "acceleration_measure": "A_n = sum_k omega_k^2 r_k Theta_q(omega_k / omega_n)",
    "frequency_equation": "omega_n^2 mu(A_n / a0) = omega_N,n^2",
    "amplitude_convention": "r_k is a root mean square amplitude. A cosine peak amplitude is sqrt(2) times r_k.",
    "circular_normalization": "Theta_q(1) = 1 for every q, so the single-frequency circular relation is identical.",
    "single_frequency_solution": "omega^2 = [omega_N^2 + sqrt(omega_N^4 + 4 omega_N^2 a0 / r)] / 2"
  },
