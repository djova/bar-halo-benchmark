  "limitations": [
    {
      "id": "LIM-01",
      "text": "One isochrone fast-action slice and finite windows/times; no total halo torque or universal 4.7 correction."
    },
    {
      "id": "LIM-02",
      "text": "Imposed bar and population-independent additive noise; no collective halo response or calibrated SIDM operator."
    },
    {
      "id": "LIM-03",
      "text": "Approximate sampling coverage and numerical-refinement proxies; no rigorous operational 5% guarantee."
    },
    {
      "id": "LIM-04",
      "text": "Eight qualified comparisons share one new dynamical condition and correlated kernel; no eight independent physical regimes."
    },
    {
      "id": "LIM-05",
      "text": "Prescribed-field 3D transfer remains unresolved; even successful transfer would not validate a live halo."
    },
    {
      "id": "LIM-06",
      "text": "Cost-times-variance ratios project precision under a fixed workflow; no measured 6900-fold faster simulation."
    },
    {
      "id": "LIM-07",
      "text": "Specific estimator priority and astrophysical generalization remain open; not externally reviewed."
    },
    {
      "id": "LIM-08",
      "text": "Software reproduction and deployment checks do not independently confirm physics."
    }
  ],
